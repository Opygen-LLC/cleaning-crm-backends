# Production backend template. Store values in your deployment secret manager;
# do not commit a filled copy.
NODE_ENV=production
PROCESS_ROLE=api
BACKEND_IP=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://user:password@db.example.com:5432/cleaning_crm?sslmode=require
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_DB=0

BETTER_AUTH_SECRET=replace-with-32-plus-random-characters-better-auth
BETTER_AUTH_URL=http://34.131.56.92
APP_URL=https://cleaningcrm.opygen.com
FRONTEND_URL=https://cleaningcrm.opygen.com
AUTH_ALLOWED_ORIGINS=https://cleaningcrm.opygen.com,http://34.131.56.92,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
ACCESS_TOKEN_SECRET=replace-with-32-plus-random-characters-access
REFRESH_TOKEN_SECRET=replace-with-32-plus-random-characters-refresh
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d

SMTP_EMAIL=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_HOST=smtp.example.com
SMTP_PORT=465

CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-cloud-api-key
CLOUDINARY_API_SECRET=replace-cloud-api-secret

WEBSITE_BASE_DOMAIN=cleaningcrm.opygen.com
NEXT_REVALIDATE_URL=https://cleaningcrm.opygen.com/api/public-site/revalidate
NEXT_REVALIDATE_SECRET=replace-with-32-plus-random-characters-revalidate
PERFORMANCE_METRICS_TOKEN=replace-with-32-plus-random-characters-monitoring

APP_VERSION=1.0.0
GIT_SHA=replace-with-deployed-git-sha
BUILD_DATE=2026-08-31T00:00:00Z
