<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Your trial is ending soon — Opygen CleanCRM</title>
    </head>
    <body
        style="
            margin: 0;
            padding: 0;
            background: #f0f2f5;
            font-family:
                -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;,
                Helvetica, Arial, sans-serif;
        "
    >
        <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            role="presentation"
            style="padding: 48px 16px"
        >
            <tr>
                <td align="center">
                    <table
                        width="480"
                        cellpadding="0"
                        cellspacing="0"
                        role="presentation"
                        style="
                            background: #ffffff;
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
                        "
                    >
                        <!-- Top accent bar -->
                        <tr>
                            <td
                                style="
                                    background: #0a0a0a;
                                    height: 4px;
                                    font-size: 0;
                                    line-height: 0;
                                "
                            >
                                &nbsp;
                            </td>
                        </tr>

                        <!-- Header -->
                        <tr>
                            <td align="center" style="padding: 36px 40px 0">
                                <table cellpadding="0" cellspacing="0" role="presentation">
                                    <tr>
                                        <td align="center" style="padding-bottom: 24px">
                                            <table cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td style="border-radius: 14px; padding: 10px 12px; vertical-align: middle;">
                                                        <svg viewBox="0 0 64 64" width="38" height="38" fill="none" class="shrink-0">
                                                            <path d="M32 6 A26 26 0 1 1 53.5 45.5" stroke="#3ECFB2" strokeWidth="5" strokeLinecap="round" fill="none"></path>
                                                            <path d="M32 58 A26 26 0 1 1 10.5 18.5" stroke="#000000" strokeWidth="5" strokeLinecap="round" fill="none" opacity="0.75"></path>
                                                            <circle cx="32" cy="32" r="4" fill="#3ECFB2"></circle>
                                                            <circle cx="53.5" cy="45.5" r="2.5" fill="#3ECFB2"></circle>
                                                            <circle cx="10.5" cy="18.5" r="2.5" fill="#ffffff" opacity="0.3"></circle>
                                                        </svg>
                                                    </td>
                                                    <td style="padding-left: 10px; vertical-align: middle;">
                                                        <span style="font-size: 20px; font-weight: 700; color: #0a0a0a; letter-spacing: -0.5px;">Opygen</span>
                                                        <span style="display: block; font-size: 10px; font-weight: 600; color: #1a7a5e; letter-spacing: 0.12em; text-transform: uppercase; margin-top: 2px;">Cleaning CRM</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Divider -->
                                <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                                    <tr>
                                        <td style="border-top: 1px solid #f0f0f0; font-size: 0;">&nbsp;</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Body -->
                        <tr>
                            <td style="padding: 32px 40px 0">
                                <p style="margin: 0 0 6px; font-size: 22px; font-weight: 700; color: #0a0a0a; letter-spacing: -0.4px;">
                                    Your trial is ending soon
                                </p>
                                <p style="margin: 0 0 24px; font-size: 15px; color: #6b6b6b; line-height: 1.6;">
                                    Hi
                                    <strong style="color: #0a0a0a; font-weight: 600"><%= adminName %></strong>, your free trial of the
                                    <strong style="color: #0a0a0a; font-weight: 600"><%= planName %></strong>
                                    plan is coming to an end. Upgrade now to keep your bookings, clients, and team data running without interruption.
                                </p>

                                <!-- Days remaining box -->
                                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom: 28px">
                                    <tr>
                                        <td align="center">
                                            <table cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td style="background: #f6f6f6; border: 1.5px solid #e8e8e8; border-radius: 14px; padding: 20px 36px; text-align: center;">
                                                        <span style="font-size: 36px; font-weight: 800; letter-spacing: -1px; color: #0a0a0a; font-variant-numeric: tabular-nums;">
                                                            <%= daysLeft %>
                                                        </span>
                                                        <p style="margin: 10px 0 0; font-size: 11px; font-weight: 600; color: #aaaaaa; text-transform: uppercase; letter-spacing: 0.12em;">
                                                            Day<% if (daysLeft !== 1) { %>s<% } %> remaining
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Trial end date pill -->
                                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom: 28px">
                                    <tr>
                                        <td align="center">
                                            <table cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td style="background: #e8f5f0; border-radius: 100px; padding: 8px 20px;">
                                                        <span style="font-size: 12px; font-weight: 600; color: #1a7a5e; letter-spacing: 0.04em;">
                                                            ⏱ Trial ends <%= trialEnd %>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- CTA button -->
                                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom: 32px">
                                    <tr>
                                        <td align="center">
                                            <table cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td style="background: #0a0a0a; border-radius: 10px;">
                                                        <a href="#" style="display: inline-block; padding: 14px 32px; font-size: 14px; font-weight: 600; color: #ffffff; text-decoration: none; letter-spacing: 0.02em;">
                                                            Upgrade your plan
                                                        </a>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Info note -->
                                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background: #f9f9f9; border-radius: 12px; margin-bottom: 32px;">
                                    <tr>
                                        <td style="padding: 16px 20px">
                                            <table cellpadding="0" cellspacing="0" role="presentation" width="100%">
                                                <tr>
                                                    <td style="vertical-align: top; width: 20px; padding-right: 10px;">
                                                        <span style="font-size: 14px">💡</span>
                                                    </td>
                                                    <td>
                                                        <p style="margin: 0; font-size: 12.5px; color: #6b6b6b; line-height: 1.65;">
                                                            <strong style="color: #0a0a0a; font-weight: 600">Heads up:</strong>
                                                            once your trial ends, access to your dashboard will be paused until you choose a paid plan. Your data is safe and will be restored as soon as you upgrade.
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td style="padding: 0 40px 36px">
                                <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                                    <tr>
                                        <td style="border-top: 1px solid #f0f0f0; padding-top: 24px;">
                                            <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td>
                                                        <p style="margin: 0; font-size: 11px; color: #aaaaaa; line-height: 1.7;">
                                                            This email was sent to you because you have an active trial subscription on your
                                                            <strong style="color: #6b6b6b">Opygen CleanCRM</strong> account.
                                                        </p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-top: 12px">
                                                        <p style="margin: 0; font-size: 11px; color: #cccccc;">
                                                            © <%= new Date().getFullYear() %> Opygen · Cleaning CRM · Powered by IXYRON
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
