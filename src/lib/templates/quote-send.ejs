<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote <%= quoteRef %> — Opygen CleanCRM</title>
  </head>
  <body style="margin:0;padding:0;background:#f0f2f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="padding:48px 16px;">
      <tr>
        <td align="center">
          <table width="480" cellpadding="0" cellspacing="0" role="presentation" style="background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.07);">

            <!-- Accent bar -->
            <tr><td style="background:#0a0a0a;height:4px;font-size:0;line-height:0;">&nbsp;</td></tr>

            <!-- Logo -->
            <tr>
              <td align="center" style="padding:36px 40px 0;">
                <table cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td align="center" style="padding-bottom:24px;">
                      <table cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                          <td style="border-radius:14px;padding:10px 12px;vertical-align:middle;">
                            <svg viewBox="0 0 64 64" width="38" height="38" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M32 6 A26 26 0 1 1 53.5 45.5" stroke="#3ECFB2" stroke-width="5" stroke-linecap="round" fill="none"></path>
                              <path d="M32 58 A26 26 0 1 1 10.5 18.5" stroke="#000000" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.75"></path>
                              <circle cx="32" cy="32" r="4" fill="#3ECFB2"></circle>
                              <circle cx="53.5" cy="45.5" r="2.5" fill="#3ECFB2"></circle>
                              <circle cx="10.5" cy="18.5" r="2.5" fill="#ffffff" opacity="0.3"></circle>
                            </svg>
                          </td>
                          <td style="padding-left:10px;vertical-align:middle;">
                            <span style="font-size:20px;font-weight:700;color:#0a0a0a;letter-spacing:-0.5px;">Opygen</span>
                            <span style="display:block;font-size:10px;font-weight:600;color:#1a7a5e;letter-spacing:0.12em;text-transform:uppercase;margin-top:2px;">Cleaning CRM</span>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                  <tr><td style="border-top:1px solid #f0f0f0;font-size:0;">&nbsp;</td></tr>
                </table>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:32px 40px 0;">

                <!-- Badge -->
                <table cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:20px;">
                  <tr>
                    <td style="background:#eef2ff;border-radius:100px;padding:6px 14px;">
                      <span style="font-size:11px;font-weight:700;color:#4338CA;letter-spacing:0.1em;text-transform:uppercase;">📋 Your Quote Is Ready</span>
                    </td>
                  </tr>
                </table>

                <!-- Greeting -->
                <p style="margin:0 0 6px;font-size:22px;font-weight:700;color:#0a0a0a;letter-spacing:-0.4px;">Hi <%= clientName %>,</p>
                <p style="margin:0 0 28px;font-size:15px;color:#6b6b6b;line-height:1.6;">
                  Thank you for your interest in <strong style="color:#0a0a0a;"><%= businessName %></strong>. Please find your quote below — use the secure link to review, accept or decline it. It's valid until <strong style="color:#0a0a0a;"><%= validUntil %></strong>.
                </p>

                <!-- Quote summary card -->
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f6f6f6;border:1.5px solid #e8e8e8;border-radius:14px;margin-bottom:24px;overflow:hidden;">

                  <!-- Ref row -->
                  <tr>
                    <td style="padding:18px 24px 14px;">
                      <p style="margin:0 0 3px;font-size:10px;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:0.12em;">Quote Reference</p>
                      <p style="margin:0;font-size:18px;font-weight:800;color:#0a0a0a;letter-spacing:1px;font-family:'Courier New',monospace;"><%= quoteRef %></p>
                    </td>
                  </tr>

                  <tr><td style="border-top:1px solid #e8e8e8;font-size:0;line-height:0;">&nbsp;</td></tr>

                  <!-- Service + address -->
                  <tr>
                    <td style="padding:14px 24px;">
                      <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                          <td style="width:50%;vertical-align:top;padding-right:12px;">
                            <p style="margin:0 0 3px;font-size:10px;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:0.12em;">Service</p>
                            <p style="margin:0;font-size:14px;font-weight:600;color:#0a0a0a;"><%= serviceType %></p>
                          </td>
                          <td style="width:50%;vertical-align:top;">
                            <p style="margin:0 0 3px;font-size:10px;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:0.12em;">Address</p>
                            <p style="margin:0;font-size:13px;font-weight:500;color:#444;"><%= address %></p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <tr><td style="border-top:1px solid #e8e8e8;font-size:0;line-height:0;">&nbsp;</td></tr>

                  <!-- Line items -->
                  <tr>
                    <td style="padding:14px 24px;">
                      <p style="margin:0 0 10px;font-size:10px;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:0.12em;">Line Items</p>
                      <% lineItems.forEach(function(item) { %>
                      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:6px;">
                        <tr>
                          <td style="font-size:13px;color:#444;"><%= item.description %> &times; <%= item.quantity %></td>
                          <td align="right" style="font-size:13px;font-weight:600;color:#0a0a0a;white-space:nowrap;">£<%= item.total %></td>
                        </tr>
                      </table>
                      <% }); %>
                    </td>
                  </tr>

                  <tr><td style="border-top:1px solid #e8e8e8;font-size:0;line-height:0;">&nbsp;</td></tr>

                  <!-- Totals -->
                  <tr>
                    <td style="padding:14px 24px 18px;">
                      <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                          <td style="font-size:12px;color:#888;">Subtotal</td>
                          <td align="right" style="font-size:12px;color:#888;">£<%= subtotal %></td>
                        </tr>
                        <tr>
                          <td style="font-size:12px;color:#888;padding-top:4px;">VAT (<%= taxRate %>%)</td>
                          <td align="right" style="font-size:12px;color:#888;padding-top:4px;">£<%= tax %></td>
                        </tr>
                        <tr>
                          <td style="font-size:15px;font-weight:700;color:#0a0a0a;padding-top:10px;border-top:1px solid #e8e8e8;">Total</td>
                          <td align="right" style="font-size:16px;font-weight:800;color:#0a0a0a;padding-top:10px;border-top:1px solid #e8e8e8;">£<%= total %></td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <% if (notes) { %>
                <p style="margin:0 0 24px;font-size:13px;color:#6b6b6b;line-height:1.6;background:#fafafa;border-left:3px solid #e8e8e8;padding:12px 16px;border-radius:0 8px 8px 0;"><%= notes %></p>
                <% } %>

                <!-- CTA buttons -->
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:32px;">
                  <tr>
                    <td align="center">
                      <table cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                          <td style="padding-right:8px;">
                            <a href="<%= quoteViewUrl %>" target="_blank"
                              style="display:inline-block;background:#0a0a0a;color:#ffffff;text-decoration:none;font-size:14px;font-weight:700;letter-spacing:0.02em;padding:15px 28px;border-radius:100px;">
                              View &amp; Accept Quote →
                            </a>
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="padding-top:12px;">
                            <p style="margin:0;font-size:11px;color:#cccccc;">This quote expires on <%= validUntil %>. After that it can no longer be accepted.</p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:0 40px 36px;">
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td style="border-top:1px solid #f0f0f0;padding-top:24px;">
                      <p style="margin:0 0 6px;font-size:11px;color:#aaa;line-height:1.7;">
                        You received this quote from <strong style="color:#6b6b6b;"><%= businessName %></strong> via Opygen CleanCRM.
                        If you weren't expecting this, please ignore it.
                      </p>
                      <p style="margin:0;font-size:11px;color:#ccc;">© <%= new Date().getFullYear() %> Opygen · Cleaning CRM</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
