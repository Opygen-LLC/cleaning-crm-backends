{
  "name": "opygen-crm-backends",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/devProcesses.mjs",
    "build": "prisma generate && tsc --noEmit && tsup",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "pnpm run start:api",
    "vercel-build": "pnpm run build",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "push": "node scripts/forbidDbPush.mjs",
    "pull": "prisma db pull",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill:websites": "tsx src/scripts/backfillBusinessWebsites.ts",
    "migrate:phase2-websites": "pnpm run backfill:websites",
    "backfill:websites:dry-run": "tsx src/scripts/backfillBusinessWebsites.ts --dry-run",
    "backfill:websites:prod": "node dist/backfillBusinessWebsites.js",
    "migrate:phase2-websites:prod": "node dist/backfillBusinessWebsites.js",
    "migrate:phase21-existing-websites": "pnpm run backfill:websites",
    "migrate:phase21-existing-websites:dry-run": "pnpm run backfill:websites:dry-run",
    "migrate:phase21-existing-websites:prod": "node dist/backfillBusinessWebsites.js",
    "migrate:phase10-websites": "tsx src/scripts/migrateWebsiteRelease.ts",
    "migrate:phase10-websites:dry-run": "tsx src/scripts/migrateWebsiteRelease.ts --dry-run",
    "migrate:phase10-websites:prod": "node dist/migrateWebsiteRelease.js",
    "load:phase10:public": "tsx src/scripts/load/phase10LoadTest.ts --mode=public --users=500",
    "load:phase10:dashboard": "tsx src/scripts/load/phase10LoadTest.ts --mode=dashboard --users=500",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:preflight": "node scripts/phase2MigrationPreflight.mjs",
    "db:drift:check": "node scripts/phase2DriftCheck.mjs",
    "db:baseline:capture": "node scripts/captureProductionSchemaBaseline.mjs",
    "check:repo-hygiene": "node scripts/checkRepositoryHygiene.mjs",
    "provisioning:reconcile": "tsx src/scripts/phase2/reconcileAdminProvisioning.ts",
    "provisioning:reconcile:dry-run": "tsx src/scripts/phase2/reconcileAdminProvisioning.ts --dry-run",
    "provisioning:reconcile:prod": "node dist/reconcileAdminProvisioning.js",
    "perf:phase3:explain": "tsx src/scripts/phase3/explainHotPaths.ts",
    "dev:api": "PROCESS_ROLE=api tsx --watch src/index.ts",
    "dev:worker": "PROCESS_ROLE=worker tsx --watch src/processes/worker.ts",
    "dev:scheduler": "PROCESS_ROLE=scheduler tsx --watch src/processes/scheduler.ts",
    "start:api": "PROCESS_ROLE=api node ./dist/index.js",
    "start:worker": "PROCESS_ROLE=worker node ./dist/worker.js",
    "start:scheduler": "PROCESS_ROLE=scheduler node ./dist/scheduler.js",
    "start:bootstrap": "PROCESS_ROLE=bootstrap node ./dist/bootstrap.js",
    "dev:all": "INCLUDE_SCHEDULER=true node scripts/devProcesses.mjs",
    "perf:phase4:explain": "tsx src/scripts/phase4/explainHotPaths.ts",
    "check:secrets": "node scripts/phase7/checkSecretSafety.mjs",
    "monitoring:alerts": "node scripts/phase7/checkMonitoringAlerts.mjs",
    "test:integration": "vitest run src/modules/Auth/accountProvisioning.test.ts src/modules/Admin/admin.service.onboarding.test.ts src/modules/ServiceCatalog/serviceCatalog.contract.test.ts src/modules/Website/websiteAcquisitionIntegration.test.ts",
    "release:check": "pnpm run check:repo-hygiene && pnpm run check:secrets && node scripts/verifyPhase5Security.mjs && node scripts/verifyPhase6Observability.mjs && node scripts/verifyAuthPhase6.mjs && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:release-infra": "node scripts/phase7/verifyPhase7Release.mjs",
    "load:staging:warm": "k6 run -e CACHE_MODE=warm scripts/load/phase7-load.js",
    "load:staging:cold": "k6 run -e CACHE_MODE=cold scripts/load/phase7-load.js"
  },
  "keywords": [],
  "author": "opygen",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@vercel/functions": "^3.4.4",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.6.5",
    "body-parser": "^2.2.0",
    "chalk": "^5.6.2",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ejs": "^5.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "8.6.2",
    "heic-convert": "^2.1.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "validator": "^13.15.15",
    "vercel": "^51.7.0",
    "web-push": "3.6.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.4",
    "@types/heic-convert": "^2.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/validator": "^13.15.3",
    "@types/web-push": "3.6.4",
    "nodemon": "^3.1.10",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.1"
}
