NODE_ENV=development
BACKEND_IP=10.10.11.69
PORT=5000

DATABASE_URL=postgresql://postgres:password@localhost:5432/cleaning-crm?schema=public

BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:5000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d

#? Super Admin Credentials
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=YourPassword@123

#? Email / SMTP
SMTP_EMAIL=your@email.com
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

#? Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

#? Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Secret key — from Dashboard → API keys
STRIPE_SECRET_KEY=sk_test_xxx

# Connect platform client ID — from Dashboard → Connect → Settings
STRIPE_CLIENT_ID=ca_xxx

# Webhook signing secret — from Dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── PayPal PPCP ───────────────────────────────────────────────────────────────
# Platform app credentials — from PayPal Developer Dashboard
PAYPAL_CLIENT_ID=xxx
PAYPAL_SECRET=xxx

# Your platform's PayPal merchant/partner ID (payer_id)
# Find it: PayPal Developer Dashboard → My Apps → your app → Partner ID
PAYPAL_PARTNER_ID=xxx

# "true" for sandbox, "false" for live
PAYPAL_SANDBOX=true

# Optional: logo URL shown on the PayPal onboarding page
# PAYPAL_PARTNER_LOGO_URL=https://yourapp.com/logo.png

# ─── Token encryption ──────────────────────────────────────────────────────────
# 64-character hex string (32 bytes) for AES-256-GCM encryption of stored tokens
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key
