# Cleaning CRM backend active configuration
NODE_ENV=production
PROCESS_ROLE=api
BACKEND_IP=127.0.0.1
PORT=5000
DEPLOYMENT_PROFILE=production

# PostgreSQL (Neon Serverless)
# DATABASE_URL: POOLED Neon connection (contains "-pooler")
DATABASE_URL=postgresql://user:password@localhost:5432/cleaning_crm?schema=public

# DIRECT_URL: DIRECT Neon connection for Prisma CLI/migrations (no "-pooler")
DIRECT_URL=postgresql://user:password@localhost:5432/cleaning_crm?schema=public

DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Redis Container
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_DB=0

# Durable outbox process ownership
# docker-compose overrides OUTBOX_WORKER_ENABLED per process role.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_REQUIRED=true
OUTBOX_WORKER_POLL_MS=2000
OUTBOX_WORKER_BATCH_SIZE=25
OUTBOX_LOCK_TIMEOUT_MS=120000

# Auth & Topology Configuration
API_DOMAIN=api.example.com
BETTER_AUTH_SECRET=replace-better-auth-secret-with-32-plus-random-characters
BETTER_AUTH_URL=https://api.example.com
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
AUTH_ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1

# JWT Configuration
ACCESS_TOKEN_SECRET=replace-access-token-secret-with-32-plus-random-characters
REFRESH_TOKEN_SECRET=replace-refresh-token-secret-with-32-plus-random-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_REUSE_GRACE_MS=10000

# Bootstrap-only Super Admin credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-super-admin-password-with-a-strong-unique-value

# SMTP Email Configuration
SMTP_EMAIL=noreply@example.com
SMTP_PASSWORD=replace-smtp-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Cleaning CRM
SMTP_VERIFY_ON_STARTUP=false
SMTP_HEALTHCHECK_INTERVAL_MS=300000

# Cloudflare R2 Media Storage (backend only; never expose these as NEXT_PUBLIC_*)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=replace-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-r2-secret-access-key
R2_API_TOKEN=replace-r2-api-token
R2_PUBLIC_BUCKET=cleaning-crm-public
R2_PRIVATE_BUCKET=cleaning-crm-private
R2_ENDPOINT=https://00000000000000000000000000000000.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://media.example.com
ALLOW_R2_DEV_DOMAIN=false
R2_UPLOAD_URL_TTL_SECONDS=300
R2_PRIVATE_DOWNLOAD_TTL_SECONDS=300
R2_MAX_IMAGE_SIZE_MB=10
R2_MAX_DOCUMENT_SIZE_MB=100
R2_IMAGE_PROCESSING_CONCURRENCY=2


# Website Routing & Signed Cache Revalidation
WEBSITE_BASE_DOMAIN=sites.example.com
WEBSITE_CUSTOM_DOMAINS_ENABLED=false
WEBSITE_DOMAIN_PROVIDER=manual
WEBSITE_CNAME_TARGET=sites.example.com
NEXT_REVALIDATE_URL=https://app.example.com/api/revalidate
NEXT_REVALIDATE_SECRET=replace-next-revalidate-secret-with-32-plus-random-characters
NEXT_REVALIDATE_TIMEOUT_MS=5000
# Release Metadata
APP_VERSION=1.0.0
GIT_SHA=replace-with-release-sha
BUILD_DATE=2026-09-11T00:00:00.000Z

# Monitoring & Performance Configuration
PERFORMANCE_METRICS_TOKEN=replace-performance-metrics-token-with-32-plus-random-characters
PRIMARY_REGION=asia-south1
APP_REGION=asia-south1
DATABASE_REGION=asia-south1
REQUIRE_COLOCATED_INFRA=false

# Google Analytics 4 (Website Studio)
GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=replace-google-analytics-client-id
GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=replace-google-analytics-client-secret
GOOGLE_ANALYTICS_OAUTH_REDIRECT_URI=https://app.example.com/api/google-analytics/callback
GOOGLE_ANALYTICS_TOKEN_ENCRYPTION_KEY=replace-google-analytics-token-encryption-key-32-plus
GOOGLE_ANALYTICS_OAUTH_STATE_SECRET=replace-google-analytics-oauth-state-secret-32-plus

# Template rollout: deploy the v2 public frontend and catalog assets FIRST.
# Selection gate and registration default are independent. Existing rows are pinned.
# Website template rollout. v3 is safe only when the matching frontend runtime
# is deployed. For a staged rollout, disable v3 and choose an older default.
WEBSITE_TEMPLATE_V2_ENABLED=true
WEBSITE_TEMPLATE_V3_ENABLED=true
WEBSITE_DEFAULT_TEMPLATE_VERSION=3

VERCEL_ACCESS_TOKEN=re place-vercel-token
VERCEL_PROJECT_ID=replace-vercel-project-id
