# Cleaning CRM backend
NODE_ENV=development
BACKEND_IP=0.0.0.0
PORT=3000
PROCESS_ROLE=api

# PostgreSQL
# For a public cloud database, allow this backend VM/network in the provider
# firewall/IP allowlist and keep sslmode=require in the runtime URL. Prefer the
# provider's pooled runtime URL when available.
DATABASE_URL=postgresql://user:password@localhost:5432/cleaning_crm?schema=public
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_CONNECTION_TIMEOUT_MS=8000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth / first-party browser topology
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters-better-auth
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
AUTH_ALLOWED_ORIGINS=http://localhost:3001
ACCESS_TOKEN_SECRET=replace-with-32-plus-random-characters-access
REFRESH_TOKEN_SECRET=replace-with-32-plus-random-characters-refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_REUSE_GRACE_MS=8000

# Bootstrap-only Super Admin credentials
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-bootstrap-password

# SMTP
SMTP_EMAIL=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Opygen Cleaning CRM

# Cloudinary remains a production dependency
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-cloud-api-key
CLOUDINARY_API_SECRET=replace-cloud-api-secret

# Website routing / signed cache revalidation
WEBSITE_BASE_DOMAIN=cleaningcrm.opygen.com
WEBSITE_CUSTOM_DOMAINS_ENABLED=false
WEBSITE_DOMAIN_PROVIDER=manual
WEBSITE_CNAME_TARGET=cleaningcrm.opygen.com
NEXT_REVALIDATE_URL=http://localhost:3001/api/public-site/revalidate
NEXT_REVALIDATE_SECRET=replace-with-32-plus-random-characters-revalidate

# Release metadata
APP_VERSION=1.0.0
GIT_SHA=local
BUILD_DATE=local

# Monitoring
PERFORMANCE_METRICS_TOKEN=replace-with-32-plus-random-characters-monitoring
