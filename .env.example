# Cleaning CRM backend active configuration
NODE_ENV=production
PROCESS_ROLE=api
BACKEND_IP=0.0.0.0
PORT=3000
DEPLOYMENT_PROFILE=primary-region

# PostgreSQL (Neon Serverless)
# DATABASE_URL: POOLED Neon connection (contains "-pooler")
DATABASE_URL=postgresql://user:password@localhost:5432/cleaning_crm?schema=public

# DIRECT_URL: DIRECT Neon connection for Prisma CLI/migrations (no "-pooler")
DIRECT_URL=postgresql://user:password@localhost:5432/cleaning_crm?schema=public

DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Redis Container
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Durable outbox process ownership
# docker-compose overrides OUTBOX_WORKER_ENABLED per process role.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_REQUIRED=true
OUTBOX_WORKER_POLL_MS=1000
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_LOCK_TIMEOUT_MS=120000

# Auth & Topology Configuration
API_DOMAIN=api-3000.faysaldev.com
BETTER_AUTH_SECRET=replace-with-a-unique-better-auth-secret-value
BETTER_AUTH_URL=https://api-3000.faysaldev.com
APP_URL=https://cleaningcrm.opygen.com
FRONTEND_URL=https://cleaningcrm.opygen.com
AUTH_ALLOWED_ORIGINS=https://cleaningcrm.opygen.com,https://api-3000.faysaldev.com,http://34.131.56.92,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
TRUST_PROXY_HOPS=1

# JWT Configuration
ACCESS_TOKEN_SECRET=replace-with-a-unique-access-token-secret-value
REFRESH_TOKEN_SECRET=replace-with-a-unique-refresh-token-secret-value
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_REUSE_GRACE_MS=8000

# Bootstrap-only Super Admin credentials
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-super-admin-password-value

# SMTP Email Configuration
# For Gmail, SMTP_PASSWORD must be a Google App Password (not the account password).
# Port 587 uses STARTTLS, therefore Nodemailer secure=false. Port 465 uses secure=true.
SMTP_EMAIL=opygen.info@gmail.com
SMTP_PASSWORD=replace-with-a-google-app-password-or-smtp-credential
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=opygen.info@gmail.com
SMTP_FROM_NAME="Opygen Cleaning CRM"
SMTP_VERIFY_ON_STARTUP=true
SMTP_HEALTHCHECK_INTERVAL_MS=300000

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=we
CLOUDINARY_API_KEY=replace-with-a-unique-cloudinary-api-key-value
CLOUDINARY_API_SECRET=replace-with-a-unique-cloudinary-api-secret-value

# Website Routing & Signed Cache Revalidation
WEBSITE_BASE_DOMAIN=cleaningcrm.opygen.com
WEBSITE_CUSTOM_DOMAINS_ENABLED=false
WEBSITE_DOMAIN_PROVIDER=manual
WEBSITE_CNAME_TARGET=cleaningcrm.opygen.com
NEXT_REVALIDATE_URL=https://cleaningcrm.opygen.com/api/public-site/revalidate
NEXT_REVALIDATE_SECRET=replace-with-a-unique-next-revalidate-secret-value
NEXT_REVALIDATE_TIMEOUT_MS=2500

# Release Metadata
APP_VERSION=1.0.0
GIT_SHA=production
BUILD_DATE=2026-08-31T00:00:00Z

# Monitoring & Performance Configuration
PERFORMANCE_METRICS_TOKEN=replace-with-a-unique-performance-metrics-token-value
PRIMARY_REGION=us-east-1
APP_REGION=us-east-1
DATABASE_REGION=us-east-1
REQUIRE_COLOCATED_INFRA=false

# Google Analytics 4 (Website Studio)
GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=575078523044-iweuiowuheirwer
GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=replace-with-a-unique-google-analytics-oauth-client-secret-value
GOOGLE_ANALYTICS_OAUTH_REDIRECT_URI=https://cleaningcrm.opygen.com/admin/dashboard/website
GOOGLE_ANALYTICS_TOKEN_ENCRYPTION_KEY=replace-with-a-unique-google-analytics-token-encryption-key-value
GOOGLE_ANALYTICS_OAUTH_STATE_SECRET=replace-with-a-unique-google-analytics-oauth-state-secret-value

# Template rollout: deploy the v2 public frontend and catalog assets FIRST.
# Selection gate and registration default are independent. Existing rows are pinned.
# Website template rollout. v3 is safe only when the matching frontend runtime
# is deployed. For a staged rollout, disable v3 and choose an older default.
WEBSITE_TEMPLATE_V2_ENABLED=true
WEBSITE_TEMPLATE_V3_ENABLED=true
WEBSITE_DEFAULT_TEMPLATE_VERSION=3.0.0
