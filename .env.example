# Cleaning CRM backend active configuration
NODE_ENV=production
PROCESS_ROLE=api
BACKEND_IP=0.0.0.0
PORT=3000
DEPLOYMENT_PROFILE=primary-region

# PostgreSQL (Neon Serverless)
# DATABASE_URL: POOLED Neon connection (contains "-pooler")
DATABASE_URL="postgresql://neondb_owner:werwer@ep-raspy-art-ambmdf97-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

# DIRECT_URL: DIRECT Neon connection for Prisma CLI/migrations (no "-pooler")
DIRECT_URL="postgresql://neondb_owner:werwer@ep-raspy-art-ambmdf97.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Redis Container
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Durable outbox process ownership
# docker-compose overrides OUTBOX_WORKER_ENABLED per process role.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_REQUIRED=true
OUTBOX_WORKER_POLL_MS=1000
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_LOCK_TIMEOUT_MS=120000

# Auth & Topology Configuration
API_DOMAIN=api-3000.faysaldev.com
BETTER_AUTH_SECRET=werwerwerwerwer
BETTER_AUTH_URL=https://api-3000.faysaldev.com
APP_URL=https://cleaningcrm.opygen.com
FRONTEND_URL=https://cleaningcrm.opygen.com
AUTH_ALLOWED_ORIGINS=https://cleaningcrm.opygen.com,https://api-3000.faysaldev.com,http://34.123.8.185,http://34.131.56.92,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
TRUST_PROXY_HOPS=1

# JWT Configuration
ACCESS_TOKEN_SECRET=werwerwer
REFRESH_TOKEN_SECRET=werwerwer
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_REUSE_GRACE_MS=8000

# Bootstrap-only Super Admin credentials
SUPER_ADMIN_EMAIL=werwer@gmail.com
SUPER_ADMIN_PASSWORD=aswerw@123

# SMTP Email Configuration
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_FROM_NAME="Opygen Cleaning CRM"
SMTP_VERIFY_ON_STARTUP=true
SMTP_HEALTHCHECK_INTERVAL_MS=300000

# Cloudflare R2 Media Storage (backend only; never expose these as NEXT_PUBLIC_*)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_PUBLIC_BUCKET=cleaning-crm-public
R2_PRIVATE_BUCKET=cleaning-crm-private
R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://media.cleaningcrm.opygen.com
R2_UPLOAD_URL_TTL_SECONDS=300
R2_PRIVATE_DOWNLOAD_TTL_SECONDS=300
R2_MAX_IMAGE_SIZE_MB=10
R2_MAX_DOCUMENT_SIZE_MB=25
R2_IMAGE_PROCESSING_CONCURRENCY=2


# Website Routing & Signed Cache Revalidation
WEBSITE_BASE_DOMAIN=cleaningcrm.opygen.com
WEBSITE_CUSTOM_DOMAINS_ENABLED=false
WEBSITE_DOMAIN_PROVIDER=manual
WEBSITE_CNAME_TARGET=cleaningcrm.opygen.com
NEXT_REVALIDATE_URL=https://cleaningcrm.opygen.com/api/public-site/revalidate
# NEXT_REVALIDATE_SECRET=72b6597c9a90a5c88652494f37d6da57894888763d49cdlwfjoer234234
NEXT_REVALIDATE_SECRET=werwerwer
NEXT_REVALIDATE_TIMEOUT_MS=2500
# Release Metadata
APP_VERSION=1.0.0
GIT_SHA=production
BUILD_DATE=2026-08-31T00:00:00Z

# Monitoring & Performance Configuration
PERFORMANCE_METRICS_TOKEN=werwerwer
PRIMARY_REGION=us-east-1
APP_REGION=us-east-1
DATABASE_REGION=us-east-1
REQUIRE_COLOCATED_INFRA=false

# Google Analytics 4 (Website Studio)
GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=575078523044-werwer.apps.googleusercontent.com
GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=GOCSPX-werwer
GOOGLE_ANALYTICS_OAUTH_REDIRECT_URI=https://cleaningcrm.opygen.com/admin/dashboard/website
GOOGLE_ANALYTICS_TOKEN_ENCRYPTION_KEY=werwerwer/cn97/9ldA1S6mBYhbP1y7QDqbmRhmnuw
GOOGLE_ANALYTICS_OAUTH_STATE_SECRET=werwerwer+D2cgVKfczR3e0BKJeCAZS1fDN5VVi

# Template rollout: deploy the v2 public frontend and catalog assets FIRST.
# Selection gate and registration default are independent. Existing rows are pinned.
# Website template rollout. v3 is safe only when the matching frontend runtime
# is deployed. For a staged rollout, disable v3 and choose an older default.
WEBSITE_TEMPLATE_V2_ENABLED=true
WEBSITE_TEMPLATE_V3_ENABLED=true
WEBSITE_DEFAULT_TEMPLATE_VERSION=3.0.0

