NODE_ENV=development
BACKEND_IP=10.10.11.69
PORT=5000

DATABASE_URL=postgresql://postgres:password@localhost:5432/cleaning-crm?schema=public

# Phase 1 performance / placement
# In production, move API + Postgres + Redis into one region, set all labels,
# then enable REQUIRE_COLOCATED_INFRA=true so a future misdeployment fails fast.
APP_REGION=local
DATABASE_REGION=local
REDIS_REGION=local
REQUIRE_COLOCATED_INFRA=false

# Prisma/pg pool. Size DB_POOL_MAX for your Postgres provider/compute plan.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_CONNECTION_TIMEOUT_MS=15000
SLOW_QUERY_THRESHOLD_MS=250
SLOW_REQUEST_THRESHOLD_MS=250
REQUEST_LOG_SAMPLE_RATE=0.01
API_RESPONSE_CACHE_TTL_SECONDS=300

# Protects GET /health/performance in production. Use a long random value.
PERFORMANCE_METRICS_TOKEN=replace-with-a-long-random-monitoring-token

# Keep enabled only when your Postgres plan auto-suspends.
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_CRON="*/2 * * * *"

# Phase 2 transactional outbox / email worker
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_MS=1000
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_LOCK_TIMEOUT_MS=120000

BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:5000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d

#? Super Admin Credentials
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=YourPassword@123

#? Email / SMTP
SMTP_EMAIL=your@email.com
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

#? Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

#? Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


