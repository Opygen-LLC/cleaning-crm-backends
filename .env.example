# Cleaning CRM backend production example
# Copy to .env.runtime on the GCP VM or store the same content in Google Secret Manager.
NODE_ENV=production
PROCESS_ROLE=api
BACKEND_IP=0.0.0.0
PORT=3000
DEPLOYMENT_PROFILE=primary-region

# PostgreSQL / Neon
# DATABASE_URL: POOLED Neon connection. The hostname contains "-pooler".
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"
# DIRECT_URL: DIRECT Neon connection for Prisma CLI/migrations. No "-pooler".
DIRECT_URL="postgresql://NEON_USER:NEON_PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Redis container
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Current backend endpoint. Keep the raw IP while bringing the service up.
# After DNS is ready, set API_DOMAIN=api.opygen.com and BETTER_AUTH_URL=https://api.opygen.com.
API_DOMAIN=api.opygen.com
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://api-3000.faysaldev.com
APP_URL=https://cleaningcrm.opygen.com
FRONTEND_URL=https://cleaningcrm.opygen.com
AUTH_ALLOWED_ORIGINS=https://cleaningcrm.opygen.com,http://34.131.56.92,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
TRUST_PROXY_HOPS=1

# JWT
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_REUSE_GRACE_MS=8000

# Bootstrap-only Super Admin credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# SMTP
SMTP_EMAIL=your-smtp-account@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=your-smtp-account@example.com
SMTP_FROM_NAME="Opygen Cleaning CRM"

# Media storage
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# Website routing & signed cache revalidation
WEBSITE_BASE_DOMAIN=cleaningcrm.opygen.com
WEBSITE_CUSTOM_DOMAINS_ENABLED=false
WEBSITE_DOMAIN_PROVIDER=manual
WEBSITE_CNAME_TARGET=cleaningcrm.opygen.com
NEXT_REVALIDATE_URL=https://cleaningcrm.opygen.com/api/public-site/revalidate
NEXT_REVALIDATE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Release metadata
APP_VERSION=1.0.0
GIT_SHA=REPLACE_WITH_GIT_SHA
BUILD_DATE=2026-08-31T00:00:00Z

# Monitoring / topology
PERFORMANCE_METRICS_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
PRIMARY_REGION=us-east-1
APP_REGION=us-east-1
DATABASE_REGION=us-east-1
REQUIRE_COLOCATED_INFRA=false
