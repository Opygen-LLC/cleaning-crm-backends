# Cleaning CRM backend active configuration
NODE_ENV=production
PROCESS_ROLE=api
BACKEND_IP=0.0.0.0
PORT=3000
DEPLOYMENT_PROFILE=primary-region

# PostgreSQL (Neon Serverless)
# DATABASE_URL: POOLED Neon connection (contains "-pooler")
DATABASE_URL=postgresql://user:password@localhost:5432/cleaning_crm?schema=public

# DIRECT_URL: DIRECT Neon connection for Prisma CLI/migrations (no "-pooler")
DIRECT_URL=postgresql://user:password@localhost:5432/cleaning_crm?schema=public

DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Redis Container
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth & Topology Configuration
API_DOMAIN=api.example.com
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=https://api.example.com
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
AUTH_ALLOWED_ORIGINS=https://app.example.com,https://api.example.com,http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=1

# JWT Configuration
ACCESS_TOKEN_SECRET=replace-with-64-plus-random-characters
REFRESH_TOKEN_SECRET=replace-with-different-64-plus-random-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_REUSE_GRACE_MS=8000

# Bootstrap-only Super Admin credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-bootstrap-password

# SMTP Email Configuration
SMTP_EMAIL=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME="Opygen Cleaning CRM"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Website Routing & Signed Cache Revalidation
WEBSITE_BASE_DOMAIN=sites.example.com
WEBSITE_CUSTOM_DOMAINS_ENABLED=false
WEBSITE_DOMAIN_PROVIDER=manual
WEBSITE_CNAME_TARGET=sites.example.com
NEXT_REVALIDATE_URL=https://app.example.com/api/public-site/revalidate
NEXT_REVALIDATE_SECRET=replace-with-32-plus-random-characters

# Release Metadata
APP_VERSION=1.0.0
GIT_SHA=replace-at-build-time
BUILD_DATE=replace-at-build-time

# Monitoring & Performance Configuration
PERFORMANCE_METRICS_TOKEN=replace-with-32-plus-random-characters
PRIMARY_REGION=replace-with-region
APP_REGION=replace-with-region
DATABASE_REGION=replace-with-region
REQUIRE_COLOCATED_INFRA=false

# Google Analytics 4 (Website Studio). Configure the Google OAuth web client
# redirect URI to the dashboard Website Studio analytics callback URL.
GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=
GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=
GOOGLE_ANALYTICS_OAUTH_REDIRECT_URI=
# Dedicated secret used to encrypt tenant refresh tokens at rest (32+ random chars).
GOOGLE_ANALYTICS_TOKEN_ENCRYPTION_KEY=
# Optional HMAC secret for OAuth state. Falls back to BETTER_AUTH_SECRET.
GOOGLE_ANALYTICS_OAUTH_STATE_SECRET=
