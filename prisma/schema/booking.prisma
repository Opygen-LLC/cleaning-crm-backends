//? ─── Booking ─────────────────────────────────────────────────────────────────

model Booking {
    id         String        @id @default(uuid())
    bookingRef String        @unique //? e.g. "#BK-0041" — generated by backend
    status     BookingStatus @default(SCHEDULED)

    //? Service details
    serviceType    ServiceType
    address        String
    scheduledDate  DateTime
    durationMins   Int     //? stored as minutes, e.g. 150 = "2h 30m"
    total          Decimal @db.Decimal(10, 2)
    notes          String?

    //? Relations
    adminId String
    admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

    clientId String
    client   Client @relation(fields: [clientId], references: [id])

    //? Optional source references
    quoteId String?
    quote   Quote?  @relation(fields: [quoteId], references: [id])

    //? Staff assignments (many-to-many)
    staffAssignments BookingStaffAssignment[]

    //? Downstream
    job     Job?
    invoice Invoice?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([adminId, status])
    @@index([clientId])
    @@index([scheduledDate])
    @@map("booking")
}

//? Many-to-many: Booking ↔ StaffProfile
model BookingStaffAssignment {
    bookingId String
    booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

    staffId String
    staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

    assignedAt DateTime @default(now())

    @@id([bookingId, staffId])
    @@map("booking_staff_assignment")
}
