model Booking {
  id               String                   @id @default(uuid())
  bookingRef       String                   @unique
  status           BookingStatus            @default(SCHEDULED)
  serviceType      ServiceType
  address          String
  scheduledDate    DateTime
  durationMins     Int
  total            Decimal                  @db.Decimal(10, 2)
  notes            String?
  adminId          String
  clientId         String
  quoteId          String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  admin            AdminProfile             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client           Client                   @relation(fields: [clientId], references: [id])
  quote            Quote?                   @relation(fields: [quoteId], references: [id])
  staffAssignments BookingStaffAssignment[]
  job              Job?
  invoice          Invoice?

  @@index([adminId, status])
  @@index([clientId])
  @@index([scheduledDate])
  @@map("booking")
}

model BookingStaffAssignment {
  bookingId  String
  staffId    String
  assignedAt DateTime     @default(now())
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff      StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([bookingId, staffId])
  @@map("booking_staff_assignment")
}
