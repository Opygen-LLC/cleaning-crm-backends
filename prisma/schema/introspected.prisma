model StaffLeave {
  id           String       @id
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus  @default(PENDING)
  adminNote    String?
  reviewedAt   DateTime?
  staffId      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  StaffProfile StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
}

enum StaffStatus {
  ACTIVE
  DEACTIVE
  INACTIVE
  ON_LEAVE
}
