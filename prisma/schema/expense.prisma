//? ─── Expense ─────────────────────────────────────────────────────────────────

model Expense {
    id         String          @id @default(uuid())
    expenseRef String          @unique //? e.g. "#EXP-0011" — generated by backend
    category   ExpenseCategory
    description String

    amount   Decimal  @db.Decimal(10, 2)
    currency Currency @default(USD)

    date   DateTime
    paidBy String //? staff display name or "Business"

    receipt String? //? Cloudinary URL or filename

    isRecurring        Boolean           @default(false)
    recurringFrequency ExpenseFrequency?

    notes String?

    //? Relations
    adminId String
    admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([adminId, category])
    @@index([date])
    @@map("expense")
}
