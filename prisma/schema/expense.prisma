model Expense {
  id                 String            @id @default(uuid())
  expenseRef         String            @unique // e.g. #OP-EXP-0011
  description        String
  category           ExpenseCategory
  amount             Decimal           @db.Decimal(10, 2)
  date               DateTime
  paidBy             String
  isRecurring        Boolean           @default(false)
  notes              String?           @db.Text
  
  adminId            String
  admin              AdminProfile      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([adminId, category])
  @@index([date])
  // PERF FIX (Phase 4): getRevenuePage date_trunc-aggregates expenses by
  // adminId + date range for the revenue/expense chart. Neither existing
  // index covers an adminId-scoped date range scan.
  @@index([adminId, date])
  @@map("expense")
}
