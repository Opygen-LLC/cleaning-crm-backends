model Plan {
  id                  String                   @id @default(uuid())
  price               Decimal                  @default(0) @db.Decimal(10, 2)
  interval            SubscriptionPlanInterval
  maxStaff            Int?
  maxClient           Int?
  maxBookingsPerMonth Int?

  baseCharge      Decimal @default(0.0) @db.Decimal(10, 2)
  pricePerStaff   Decimal @default(0.0) @db.Decimal(10, 2)
  pricePerClient  Decimal @default(0.0) @db.Decimal(10, 2)
  pricePerBooking Decimal @default(0.0) @db.Decimal(10, 2)

  discount        Decimal   @default(0.00) @db.Decimal(10, 2)
  discountEndDate DateTime?

  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)

  subscriptions       Subscription[]
  pendingPlanChanges  PendingPlanChange[]

  @@unique([subscriptionPlanId, interval])
}

model SubscriptionPlan {
  id          String           @id @default(uuid())
  name        SubscriptionName @unique @default(GROWTH)
  description String?
  currency    Currency         @default(USD)
  /// Canonical plan feature objects: [{ label, included, limit? }].
  /// JSON keeps editor display metadata and feature-gate state in one source of truth.
  features    Json             @default("[]")
  /// Whether this plan is visible and selectable by tenants.
  /// Defaults to true so existing rows remain active after migration.
  isActive    Boolean          @default(true)

  plans         Plan[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                    String             @id @default(uuid())
  status                SubscriptionStatus @default(ACTIVE)
  isTrial               Boolean            @default(true)
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?

  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  
  extraStaff            Int                @default(0)
  extraClient           Int                @default(0)
  extraBookingsPerMonth Int                @default(0)
  totalCost             Decimal            @db.Decimal(10, 2)

  adminId String
  admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)

  couponUsage    CouponUsage[]
  billingHistory     BillingHistory[]
  pendingPlanChanges PendingPlanChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  // PERF FIX (Phase 3, performance audit): checkSubscription.ts's status
  // gate runs on every gated request for every ADMIN user (cache miss or
  // not, this is what actually populates that cache), and
  // subscriptionExpiry.cron.ts scans for lapsed subscriptions daily. Neither
  // filter was covered by an index before — both are exact matches for
  // these two composite indexes.
  @@index([status, isTrial, currentPeriodEnd]) // paid-subscription expiry branch
  @@index([status, isTrial, trialEndsAt])      // trial expiry branch
}


/// A checkout request for changing or renewing a tenant subscription.
/// The live Subscription is intentionally left untouched while this record is
/// AWAITING_PAYMENT / UNDER_REVIEW so paying tenants retain their current access
/// until the new plan is actually approved.
model PendingPlanChange {
  id             String                  @id @default(uuid())
  status         PendingPlanChangeStatus @default(AWAITING_PAYMENT)
  quotedAmount   Decimal                 @db.Decimal(10, 2)
  currency       Currency                @default(USD)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  targetPlanId String
  targetPlan   Plan @relation(fields: [targetPlanId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  billingHistory BillingHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, status, createdAt])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([couponId, status])
}
