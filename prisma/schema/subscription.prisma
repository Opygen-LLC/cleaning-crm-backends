model Plan {
  id                  String                   @id @default(uuid())
  price               Decimal                  @db.Decimal(10, 2)
  interval            SubscriptionPlanInterval
  maxStaff            Int?
  maxClient           Int?
  maxBookingsPerMonth Int?
  subscriptionPlanId  String
  discount            Decimal                  @default(0.00) @db.Decimal(10, 2)
  discountEndDate     DateTime?
  subscriptionPlan    SubscriptionPlan         @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  subscriptions       Subscription[]

  @@unique([subscriptionPlanId, interval])
}

model SubscriptionPlan {
  id            String           @id @default(uuid())
  name          SubscriptionName @unique @default(GROWTH)
  description   String?
  currency      Currency         @default(USD)
  features      String[]
  plans         Plan[]
  subscriptions Subscription[]
}

model Subscription {
  id                    String             @id @default(uuid())
  status                SubscriptionStatus @default(ACTIVE)
  isTrial               Boolean            @default(true)
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  extraStaff            Int                @default(0)
  extraClient           Int                @default(0)
  extraBookingsPerMonth Int                @default(0)
  totalCost             Decimal            @db.Decimal(10, 2)
  adminId               String
  planId                String
  subscriptionPlanId    String
  couponId              String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  billingHistory        BillingHistory[]
  couponUsage           CouponUsage[]
  admin                 AdminProfile       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  coupon                Coupon?            @relation(fields: [couponId], references: [id])
  plan                  Plan               @relation(fields: [planId], references: [id])
  subscriptionPlan      SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)

  @@index([adminId])
}
