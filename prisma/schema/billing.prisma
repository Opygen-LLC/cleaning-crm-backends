model BillingHistory {
  id             String        @id @default(cuid())
  amount         Decimal       @db.Decimal(10, 2)
  currency       Currency      @default(USD)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  note           String?
  transactionId  String?
  invoiceUrl     String?
  paymentProofUrl String?      // ← NEW — Cloudinary URL of tenant-uploaded proof image
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Phase 6: multiple payment attempts can belong to the same plan checkout.
  // Keeping the FK on BillingHistory preserves every rejected/retried proof as
  // an immutable audit trail instead of detaching older attempts.
  planChangeId      String?
  pendingPlanChange PendingPlanChange? @relation(fields: [planChangeId], references: [id], onDelete: SetNull)

  // PERF FIX (Phase 3, performance audit): this model previously had zero
  // indexes beyond the primary key, so every query hitting it (including
  // SuperAdmin's getPendingProofs — the exact endpoint in the production
  // slow-query log — and the general billing-history list/filter endpoints)
  // forced a full sequential scan. Small today, gets worse every month as
  // billing history accumulates.
  //   - [status, createdAt] covers getPendingProofs' exact filter+sort
  //     (WHERE status = PENDING AND paymentProofUrl IS NOT NULL ORDER BY
  //     createdAt) and the general "billing history by status" list views.
  //   - [subscriptionId] — Postgres does NOT auto-index foreign key columns
  //     (unlike some other databases), so lookups/joins keyed off this FK
  //     (e.g. loading a subscription's billing history) were also an
  //     unindexed scan until now.
  @@index([status, createdAt])
  @@index([subscriptionId])
  @@index([planChangeId, createdAt])
}

