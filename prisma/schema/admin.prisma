model AdminProfile {
  id                    String                  @id @default(uuid())
  businessName          String
  businessLogo          String?
  address               String?
  currency              Currency                @default(USD)
  userId                String                  @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  brandColor            String?                 @default("#000000")
  city                  String?
  mobileNumber          String?
  zipcode               String?
  country               Country?
  businessEmail         String?
  businessType          String?
  website               String?
  /// Set once the guided setup wizard's steps are all satisfied. Persisted so
  /// completion never regresses if the admin later deletes the data that
  /// originally satisfied a step (e.g. their only client).
  onboardingCompletedAt DateTime?
  /// Onboarding steps the admin explicitly chose to skip (only ever "team",
  /// "client", "booking" — the mandatory steps 1-3 can never appear here,
  /// enforced server-side in adminService.skipOnboardingStep). Lets the
  /// wizard distinguish "not done yet" from "chose to do later" instead of
  /// inferring everything purely from whether records exist.
  skippedSteps          String[]                @default([])
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponUsage           CouponUsage[]
  reviews               Review[]
  reviewTokens          ReviewToken[]
  staff                 StaffProfile[]
  subscription          Subscription[]
  workLocations         WorkLocation[]
  bookings              Booking[]
  bookingForms          BookingForm[]
  clients               Client[]
  estimates             Estimate[]
  estimateForms         EstimateForm[]
  expenses              Expense[]
  invoices              Invoice[]
  jobs                  Job[]
  jobNotes              JobNote[] // [NEW] Phase 1
  jobAttachments        JobAttachment[] // [NEW] Phase 1
  leads                 Lead[]
  notificationPrefs     NotificationPreference?
  payment               Payment[]
  quotes                Quote[]
  quoteTemplates        QuoteTemplate[]
  checklistTemplates    ChecklistTemplate[]
  jobChecklists         JobChecklist[]
  recurringSchedules    RecurringSchedule[]
  pricingRules          PricingRules?
  serviceCatalogs       ServiceCatalog[]
  activityLogs          ActivityLog[]
  notifications         Notification[]
  bookingChangeRequests BookingChangeRequest[]

  @@index([createdAt])
}

model WorkLocation {
  id        String       @id @default(uuid())
  city      String
  postcode  String?
  notes     String?
  adminId   String
  createdAt DateTime     @default(now())
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model NotificationPreference {
  id                    String       @id @default(uuid())
  emailNewBooking       Boolean      @default(true)
  emailBookingCancelled Boolean      @default(true)
  emailBookingReminder  Boolean      @default(true)
  emailQuoteAccepted    Boolean      @default(true)
  emailQuoteDeclined    Boolean      @default(true)
  emailInvoicePaid      Boolean      @default(true)
  emailInvoiceOverdue   Boolean      @default(true)
  emailNewClient        Boolean      @default(false)
  emailStaffAssigned    Boolean      @default(false)
  emailWeeklySummary    Boolean      @default(true)
  appNewBooking         Boolean      @default(true)
  appJobStatusChange    Boolean      @default(true)
  appQuoteUpdate        Boolean      @default(true)
  appInvoiceUpdate      Boolean      @default(false)
  appClientMessage      Boolean      @default(true)
  smsBookingReminder    Boolean      @default(false)
  smsJobAssigned        Boolean      @default(false)
  reminderHoursBefore   Int          @default(24)
  digestTime            String       @default("08:00")
  adminId               String       @unique
  updatedAt             DateTime     @updatedAt
  admin                 AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

model PricingRules {
  id        String       @id @default(uuid())
  adminId   String       @unique
  rules     Json         @default("[]")
  addons    Json         @default("[]")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("pricing_rules")
}

model Notification {
  id        String           @id @default(uuid())
  adminId   String
  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  admin     AdminProfile     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, isRead])
  @@index([adminId, createdAt])
  @@map("notification")
}
