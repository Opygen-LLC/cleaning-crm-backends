model AdminProfile {
  id                    String                  @id @default(uuid())
  businessName          String
  businessLogo          String?
  businessLogoMediaAssetId String?                @unique
  address               String?
  currency              Currency                @default(USD)
  userId                String                  @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  brandColor            String?                 @default("#000000")
  city                  String?
  mobileNumber          String?
  zipcode               String?
  country               Country?
  /// Timestamp proving when this tenant country became immutable.
  /// Registration sets it immediately; the Phase 4 rollout backfills legacy rows.
  countryLockedAt       DateTime?
  /// Legacy tenants with no country are placed into an explicit one-time setup state.
  /// It is cleared atomically when the tenant claims its country.
  countrySelectionRequiredAt DateTime?
  legacyState           String?                 @map("state") @ignore
  businessEmail         String?
  businessType          String?
  licenseNumber         String?
  businessDescription   String?
  /// Canonical opening hours used by CRM and every public website template.
  /// Website page content must not duplicate these values.
  businessHours         Json?
  website               String?
  /// Persisted completion for the five-step website-first onboarding wizard.
  /// Defaults are provisioned at registration, so completion cannot be inferred
  /// from website values alone; this array makes resume/refresh deterministic.
  onboardingCompletedSteps String[]                @default([])
  /// Set only after the user launches the website or explicitly skips setup.
  onboardingCompletedAt    DateTime?
  /// Legacy compatibility for the previous six-step onboarding flow. New
  /// clients do not write or read this field for setup/checklist progress.
  skippedSteps          String[]                @default([])

  /// Platform lifecycle is tenant-scoped and independent from the owner User row.
  lifecycleStatus        TenantLifecycleStatus   @default(ACTIVE)
  suspendedAt            DateTime?
  suspendedReason        String?
  reactivatedAt          DateTime?
  preArchiveLifecycleStatus TenantLifecycleStatus?
  archivedAt             DateTime?
  archivedReason         String?
  restoredAt             DateTime?
  restoredReason         String?
  /// Permanent-deletion workflow state. PENDING_DELETION blocks tenant access
  /// while keeping enough state to retry failed external/database cleanup safely.
  deletionStartedAt      DateTime?
  deletionReason         String?
  deletionAttemptCount   Int                     @default(0)
  deletionLastAttemptAt  DateTime?
  deletionLastError      String?
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponUsage           CouponUsage[]
  reviews               Review[]
  websiteReviewContacts  WebsiteReviewContact[]
  reviewTokens          ReviewToken[]
  staff                 StaffProfile[]
  subscription          Subscription[]
  workLocations         WorkLocation[]
  bookings              Booking[]
  bookingForms          BookingForm[]
  clients               Client[]
  estimates             Estimate[]
  estimateForms         EstimateForm[]
  expenses              Expense[]
  invoices              Invoice[]
  jobs                  Job[]
  jobNotes              JobNote[] // [NEW] Phase 1
  jobAttachments        JobAttachment[] // [NEW] Phase 1
  leads                 Lead[]
  leadActivities        LeadActivity[]
  notificationPrefs     NotificationPreference?
  payment               Payment[]
  quotes                Quote[]
  quoteTemplates        QuoteTemplate[]
  checklistTemplates    ChecklistTemplate[]
  jobChecklists         JobChecklist[]
  recurringSchedules    RecurringSchedule[]
  pricingRules          PricingRules?
  serviceCatalogs       ServiceCatalog[]
  activityLogs          ActivityLog[]
  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  notificationDeliveries NotificationDelivery[]
  // Added to satisfy BookingChangeRequest.admin's back-relation —
  // rename to match whatever `BookingChangeRequest` calls this
  // relation on your side if it differs.
  bookingChangeRequests BookingChangeRequest[]
  businessWebsite       BusinessWebsite?
  websiteSubmissions    WebsiteSubmission[]
  entitlementOverride   TenantEntitlementOverride?
  mediaAssets            MediaAsset[]
  legacyMediaMigrations  LegacyMediaMigration[]

  /// Ignored relations keep pre-migration tables represented without exposing
  /// them through Prisma Client or deleting historical data.
  legacyPayments             LegacyPayment[]               @relation("LegacyPaymentAdmin") @ignore
  legacyReviews              LegacyReview[]                @relation("LegacyReviewAdmin") @ignore
  legacyPaymentGatewayConfig LegacyPaymentGatewayConfig?   @relation("LegacyPaymentGatewayConfigAdmin") @ignore

  @@index([createdAt])
  @@index([lifecycleStatus, createdAt])
  @@index([countrySelectionRequiredAt])
}

model WorkLocation {
  id        String       @id @default(uuid())
  city      String
  postcode  String?
  notes     String?
  adminId   String
  createdAt DateTime     @default(now())
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /// [Phase 2 — location-aware dispatch] Geocoded from city + postcode.
  /// Used to draw service-area coverage on the dispatch map and as a
  /// fallback origin point when a staff member has no address on file.
  latitude   Float?
  longitude  Float?
  geocodedAt DateTime?

  @@index([adminId])
}

model NotificationPreference {
  id                    String       @id @default(uuid())
  emailNewBooking       Boolean      @default(true)
  emailBookingCancelled Boolean      @default(true)
  emailBookingReminder  Boolean      @default(true)
  emailBookingDayOfReminder Boolean   @default(false)
  emailQuoteAccepted    Boolean      @default(true)
  emailQuoteDeclined    Boolean      @default(true)
  emailInvoicePaid      Boolean      @default(true)
  emailInvoiceOverdue   Boolean      @default(true)
  emailNewClient        Boolean      @default(false)
  emailStaffAssigned    Boolean      @default(false)
  emailQuoteSent        Boolean      @default(true)
  emailEstimateSent     Boolean      @default(true)
  emailInvoiceSent      Boolean      @default(true)
  emailReviewRequest    Boolean      @default(true)
  emailWeeklySummary    Boolean      @default(true)
  appNewBooking         Boolean      @default(true)
  appJobStatusChange    Boolean      @default(true)
  appQuoteUpdate        Boolean      @default(true)
  appInvoiceUpdate      Boolean      @default(false)
  appClientMessage      Boolean      @default(true)
  smsBookingReminder    Boolean      @default(false)
  smsJobAssigned        Boolean      @default(false)
  reminderHoursBefore   Int          @default(24)
  digestTime            String       @default("08:00")
  adminId               String       @unique
  updatedAt             DateTime     @updatedAt
  admin                 AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

model PricingRules {
  id        String       @id @default(uuid())
  adminId   String       @unique
  rules     Json         @default("[]")
  addons    Json         @default("[]")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("pricing_rules")
}

model Notification {
  id        String           @id @default(uuid())
  adminId   String
  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  admin     AdminProfile     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, isRead])
  @@index([adminId, createdAt])
  @@map("notification")
}

model NotificationTemplate {
  id        String       @id @default(uuid())
  adminId   String
  key       String
  channel   String       @default("EMAIL")
  subject   String?
  body      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, key])
  @@index([adminId])
  @@map("notification_template")
}
