//? ─── Quote ───────────────────────────────────────────────────────────────────

model Quote {
    id       String      @id @default(uuid())
    quoteRef String      @unique //? e.g. "#QT-0018" — generated by backend
    status   QuoteStatus @default(DRAFT)

    //? Service details
    serviceType String //? kept as String to allow custom labels; use ServiceType enum on app layer
    address     String

    //? Financials
    subtotal Decimal @db.Decimal(10, 2)
    taxRate  Decimal @db.Decimal(5, 2) //? percentage e.g. 20.00
    tax      Decimal @db.Decimal(10, 2)
    total    Decimal @db.Decimal(10, 2)

    validUntil    DateTime
    notes         String?
    internalNotes String?

    sentAt DateTime?

    //? Relations
    adminId String
    admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

    clientId String
    client   Client @relation(fields: [clientId], references: [id])

    //? Line items
    lineItems QuoteLineItem[]

    //? Downstream
    bookings Booking[]
    jobs     Job[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([adminId, status])
    @@index([clientId])
    @@map("quote")
}

model QuoteLineItem {
    id          String  @id @default(uuid())
    description String
    quantity    Int
    unitPrice   Decimal @db.Decimal(10, 2)
    total       Decimal @db.Decimal(10, 2) //? quantity × unitPrice

    quoteId String
    quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

    @@index([quoteId])
    @@map("quote_line_item")
}

//? ─── Estimate ────────────────────────────────────────────────────────────────

model Estimate {
    id          String         @id @default(uuid())
    estimateRef String         @unique //? e.g. "#EST-0010" — generated by backend
    status      EstimateStatus @default(DRAFT)

    //? Service details
    serviceType String
    address     String

    //? Cost breakdown
    labourCost    Decimal @db.Decimal(10, 2)
    materialCost  Decimal @db.Decimal(10, 2)
    overheadCost  Decimal @db.Decimal(10, 2)
    marginPercent Decimal @db.Decimal(5, 2)

    //? Financials
    subtotal Decimal @db.Decimal(10, 2)
    taxRate  Decimal @db.Decimal(5, 2)
    tax      Decimal @db.Decimal(10, 2)
    total    Decimal @db.Decimal(10, 2)

    validUntil    DateTime
    notes         String?
    internalNotes String?

    sentAt DateTime?

    //? If converted, reference to booking
    convertedToBookingRef String?

    //? Relations
    adminId String
    admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

    clientId String
    client   Client @relation(fields: [clientId], references: [id])

    lineItems EstimateLineItem[]
    jobs      Job[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([adminId, status])
    @@index([clientId])
    @@map("estimate")
}

model EstimateLineItem {
    id          String  @id @default(uuid())
    description String
    quantity    Int
    unitPrice   Decimal @db.Decimal(10, 2)
    total       Decimal @db.Decimal(10, 2)

    estimateId String
    estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

    @@index([estimateId])
    @@map("estimate_line_item")
}
