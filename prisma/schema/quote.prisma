model Quote {
  id            String          @id @default(uuid())
  quoteRef      String          @unique
  /// High-entropy capability token used by the unauthenticated client quote
  /// page. The human-readable quoteRef must never be used as public access
  /// authorization because it is predictable.
  publicToken   String?         @unique @db.VarChar(64)
  status        QuoteStatus     @default(DRAFT)
  // Canonical service identity. serviceType is retained only for legacy rows/clients.
  serviceType          String?
  serviceCatalogId     String?
  serviceNameSnapshot  String?
  address       String
  subtotal      Decimal         @db.Decimal(10, 2)
  taxRate       Decimal         @db.Decimal(5, 2)
  tax           Decimal         @db.Decimal(10, 2)
  total         Decimal         @db.Decimal(10, 2)
  validUntil    DateTime
  notes         String?
  internalNotes String?
  publishedAt   DateTime?
  sentAt        DateTime?
  respondedAt   DateTime?
  responseNote  String?         @db.Text
  adminId       String
  clientId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bookings      Booking[]
  jobs          Job[]
  admin         AdminProfile    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  lineItems     QuoteLineItem[]

  @@index([adminId, status])
  @@index([adminId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([adminId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([clientId])
  @@index([serviceCatalogId])
  @@map("quote")
}

model QuoteLineItem {
  id          String  @id @default(uuid())
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_item")
}

model Estimate {
  id                    String             @id @default(uuid())
  estimateRef           String             @unique
  /// High-entropy capability token used by the unauthenticated client estimate page.
  /// Human-readable estimateRef/UUID values must never authorize public access.
  publicToken           String?            @unique @db.VarChar(64)
  status                EstimateStatus     @default(DRAFT)
  // Canonical service identity. serviceType is retained only for legacy rows/clients.
  serviceType           String?
  serviceCatalogId      String?
  serviceNameSnapshot   String?
  address               String
  labourCost            Decimal            @db.Decimal(10, 2)
  materialCost          Decimal            @db.Decimal(10, 2)
  overheadCost          Decimal            @db.Decimal(10, 2)
  marginPercent         Decimal            @db.Decimal(5, 2)
  pricingType           String             @default("fixed")
  estimatedMin          Decimal?           @db.Decimal(10, 2)
  estimatedMax          Decimal?           @db.Decimal(10, 2)
  subtotal              Decimal            @db.Decimal(10, 2)
  taxRate               Decimal            @db.Decimal(5, 2)
  tax                   Decimal            @db.Decimal(10, 2)
  total                 Decimal            @db.Decimal(10, 2)
  validUntil            DateTime
  notes                 String?
  internalNotes         String?
  publishedAt           DateTime?
  sentAt                DateTime?
  respondedAt           DateTime?
  responseNote          String?            @db.Text
  convertedToBookingRef String?
  convertedToQuoteRef   String?
  adminId               String
  clientId              String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  admin                 AdminProfile       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client                Client             @relation(fields: [clientId], references: [id])
  serviceCatalog        ServiceCatalog?     @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  lineItems             EstimateLineItem[]
  jobs                  Job[]

  @@index([adminId, status])
  @@index([adminId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([adminId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([clientId])
  @@index([serviceCatalogId])
  @@map("estimate")
}

model EstimateLineItem {
  id          String   @id @default(uuid())
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_line_item")
}

model QuoteTemplate {
  id          String                  @id @default(uuid())
  name        String
  serviceType         String?
  serviceCatalogId    String?
  serviceNameSnapshot String?
  notes       String?
  taxRate     Decimal                 @default(20) @db.Decimal(5, 2)
  usageCount  Int                     @default(0)
  lastUsedAt  DateTime?
  adminId     String
  admin       AdminProfile            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog?       @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  lineItems   QuoteTemplateLineItem[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([adminId])
  @@index([serviceCatalogId])
  @@map("quote_template")
}

model QuoteTemplateLineItem {
  id          String        @id @default(uuid())
  description String
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(10, 2)
  templateId  String
  template    QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("quote_template_line_item")
}
