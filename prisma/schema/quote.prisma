model Quote {
  id            String          @id @default(uuid())
  quoteRef      String          @unique
  status        QuoteStatus     @default(DRAFT)
  serviceType   String
  address       String
  subtotal      Decimal         @db.Decimal(10, 2)
  taxRate       Decimal         @db.Decimal(5, 2)
  tax           Decimal         @db.Decimal(10, 2)
  total         Decimal         @db.Decimal(10, 2)
  validUntil    DateTime
  notes         String?
  internalNotes String?
  sentAt        DateTime?
  adminId       String
  clientId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bookings      Booking[]
  jobs          Job[]
  admin         AdminProfile    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id])
  lineItems     QuoteLineItem[]

  @@index([adminId, status])
  @@index([clientId])
  @@map("quote")
}

model QuoteLineItem {
  id          String  @id @default(uuid())
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_item")
}

model Estimate {
  id                    String             @id @default(uuid())
  estimateRef           String             @unique
  status                EstimateStatus     @default(DRAFT)
  serviceType           String
  address               String
  labourCost            Decimal            @db.Decimal(10, 2)
  materialCost          Decimal            @db.Decimal(10, 2)
  overheadCost          Decimal            @db.Decimal(10, 2)
  marginPercent         Decimal            @db.Decimal(5, 2)
  subtotal              Decimal            @db.Decimal(10, 2)
  taxRate               Decimal            @db.Decimal(5, 2)
  tax                   Decimal            @db.Decimal(10, 2)
  total                 Decimal            @db.Decimal(10, 2)
  validUntil            DateTime
  notes                 String?
  internalNotes         String?
  sentAt                DateTime?
  convertedToBookingRef String?
  adminId               String
  clientId              String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  admin                 AdminProfile       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client                Client             @relation(fields: [clientId], references: [id])
  lineItems             EstimateLineItem[]
  jobs                  Job[]

  @@index([adminId, status])
  @@index([clientId])
  @@map("estimate")
}

model EstimateLineItem {
  id          String   @id @default(uuid())
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_line_item")
}
