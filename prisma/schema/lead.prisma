model Lead {
    id              String    @id @default(uuid())
    leadRef         String    @unique
    name            String
    email           String
    phone           String?
    serviceInterest String
    estimatedMin    Decimal   @default(0) @db.Decimal(10, 2)
    estimatedMax    Decimal   @default(0) @db.Decimal(10, 2)
    stage           LeadStage @default(NEW)
    notes           String?
    sourceRef       String?
    // Canonical service identity for CRM acquisition. serviceInterest remains
    // a display snapshot/legacy compatibility field.
    serviceCatalogId String?
    // Stable website attribution survives subdomain/domain renames. Legacy
    // sourceRef remains for human-readable/history compatibility.
    sourceWebsiteId  String?
    convertedClientId String?
    convertedAt       DateTime?
    lastContactedAt   DateTime?

    adminId String
    admin          AdminProfile      @relation(fields: [adminId], references: [id], onDelete: Cascade)
    serviceCatalog ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
    sourceWebsite  BusinessWebsite?  @relation("WebsiteAcquisitionLead", fields: [sourceWebsiteId], references: [id], onDelete: SetNull)
    convertedClient Client?           @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
    activities      LeadActivity[]
    websiteSubmissions WebsiteSubmission[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([email, adminId])
    @@index([adminId])
    @@index([adminId, createdAt(sort: Desc), id(sort: Desc)])
    @@index([adminId, stage, createdAt(sort: Desc), id(sort: Desc)])
    @@index([adminId, phone])
    @@index([adminId, serviceCatalogId])
    @@index([sourceWebsiteId, createdAt])
    @@index([adminId, lastContactedAt])
    @@index([adminId, convertedAt])
    @@index([convertedClientId])
    @@index([stage])
    @@map("lead")
}


model LeadActivity {
    id               String             @id @default(uuid())
    adminId          String
    leadId           String
    type             LeadActivityType
    status           LeadActivityStatus @default(PENDING)
    scheduledAt      DateTime?
    completedAt      DateTime?
    assignedToUserId String?
    note             String?            @db.Text
    outcome          String?            @db.Text
    createdBy         String?
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt

    admin      AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
    lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
    assignedTo User?        @relation("LeadActivityAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
    creator    User?        @relation("LeadActivityCreator", fields: [createdBy], references: [id], onDelete: SetNull)

    @@index([adminId, status, scheduledAt])
    @@index([adminId, type, status, scheduledAt])
    @@index([leadId, createdAt(sort: Desc)])
    @@index([leadId, status, scheduledAt])
    @@index([assignedToUserId, status, scheduledAt])
    @@map("lead_activity")
}
