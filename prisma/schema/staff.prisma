model StaffProfile {
    id           String  @id @default(uuid())
    staffRole    String
    mobileNumber String
    address      String?

    /// [Phase 2 — location-aware dispatch] Geocoded from `address` so the
    /// dispatch engine can factor staff proximity/travel time into
    /// recommendations. Not part of the original Phase 2 field list
    /// (Client/WorkLocation/Job) but required for "nearest available
    /// staff" to work at all — proximity scoring is skipped for any staff
    /// member without coordinates rather than penalizing them.
    latitude   Float?
    longitude  Float?
    geocodedAt DateTime?

    hourlyRate Float?
    startDate  DateTime
    specialty  String[]    @default([])
    status     StaffStatus @default(ACTIVE)
    manuallyInactive Boolean @default(false)

    emergencyName         String?
    emergencyMobileNumber String?
    adminNote             String?

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    adminId String
    admin   AdminProfile @relation(fields: [adminId], references: [id])

    staffAvailability  StaffAvailability[]
    staffLeave         StaffLeave[]
    jobAssignments     JobStaffAssignment[]
    bookingAssignments BookingStaffAssignment[]
    recurringAssignments RecurringStaffAssignment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([adminId, staffRole])
}

model StaffAvailability {
    id String @id @default(uuid())

    day       WeekDay
    startTime String? // "09:00"
    endTime   String? // "17:00"
    isActive  Boolean @default(true)

    staffId String
    staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([staffId, day]) // one entry per day per staff
}

model StaffLeave {
    id        String   @id @default(uuid())
    startDate DateTime
    endDate   DateTime
    reason    String?

    status     LeaveStatus @default(PENDING)
    adminNote  String?
    reviewedAt DateTime?

    staffId String
    staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([staffId, status, endDate])
}
