model StaffProfile {
  id                    String                   @id @default(uuid())
  staffRole             String
  userId                String                   @unique
  adminId               String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  mobileNumber          String
  address               String?
  adminNote             String?
  emergencyMobileNumber String?
  emergencyName         String?
  hourlyRate            Float?
  specialty             String[]                 @default([])
  startDate             DateTime
  status                StaffStatus              @default(ACTIVE)
  staffAvailability     StaffAvailability[]
  StaffLeave            StaffLeave[]
  admin                 AdminProfile             @relation(fields: [adminId], references: [id])
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingAssignments    BookingStaffAssignment[]
  jobAssignments        JobStaffAssignment[]

  @@index([adminId, staffRole])
}

model StaffAvailability {
  id        String       @id @default(uuid())
  day       WeekDay
  startTime String?
  endTime   String?
  isActive  Boolean      @default(true)
  staffId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day])
}
