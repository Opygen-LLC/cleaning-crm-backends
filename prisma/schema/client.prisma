model Client {
  id                String       @id @default(uuid())
  name              String
  email             String
  phone             String
  status            ClientStatus @default(ACTIVE)
  servicePreference String       @default("")

  addressLine1 String
  addressLine2 String?
  city         String
  zipcode      String
  country      String

  /// [Phase 2 — location-aware dispatch] Geocoded from the address fields
  /// above whenever they change. Null until the first successful geocode,
  /// or if the geocoding provider could not resolve the address — callers
  /// must treat these as optional and degrade gracefully (e.g. dispatch
  /// scoring simply skips proximity for jobs/staff without coordinates).
  latitude          Float?
  longitude         Float?
  /// When the coordinates above were last (re)computed. Used to avoid
  /// re-geocoding on every update — only the address fields changing
  /// invalidates this.
  geocodedAt        DateTime?

  /// Token used to access the client self-service portal.
  /// A random UUID — separate from `id` — so portal URLs cannot be guessed
  /// by iterating over sequential IDs.  No auth session required; the token
  /// itself acts as the access credential.
  portalAccessToken String @unique @default(uuid())

  totalSpend      Decimal   @default(0) @db.Decimal(10, 2)
  totalBookings   Int       @default(0)
  lastBookingDate DateTime?

  adminId String
  admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  bookings           Booking[]
  notes              ClientNote[]
  estimates          Estimate[]
  jobs               Job[]
  quotes             Quote[]
  recurringSchedules RecurringSchedule[]
  // Added to satisfy BookingChangeRequest.client's back-relation —
  // rename to match whatever `BookingChangeRequest` calls this
  // relation on your side if it differs.
  bookingChangeRequests BookingChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, adminId])
  @@index([adminId])
  @@index([status])
  // PERF FIX (Phase 4): getDashboardOverview date_trunc-aggregates new
  // clients by adminId + createdAt range for the "Revenue Insight" chart.
  // [adminId] alone doesn't cover the createdAt range/order-by.
  @@index([adminId, createdAt])
  @@map("client")
}

model ClientNote {
  id   String @id @default(uuid())
  text String

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("client_note")
}
