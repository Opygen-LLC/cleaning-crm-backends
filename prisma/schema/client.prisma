model Client {
  id                String       @id @default(uuid())
  name              String
  email             String
  phone             String
  status            ClientStatus @default(ACTIVE)
  servicePreference String       @default("")

  addressLine1 String
  addressLine2 String?
  city         String
  zipcode      String
  country      String

  /// Legacy columns kept intentionally so old production rows are not dropped.
  /// They are excluded from Prisma Client and populated by DB defaults where needed.
  legacyPostcode   String   @default("") @map("postcode") @ignore
  legacyAvatar     String?  @map("avatar") @ignore
  legacyJoinedDate DateTime @default(now()) @map("joinedDate") @ignore

  /// [Phase 2 — location-aware dispatch] Geocoded from the address fields
  /// above whenever they change. Null until the first successful geocode,
  /// or if the geocoding provider could not resolve the address — callers
  /// must treat these as optional and degrade gracefully (e.g. dispatch
  /// scoring simply skips proximity for jobs/staff without coordinates).
  latitude          Float?
  longitude         Float?
  /// When the coordinates above were last (re)computed. Used to avoid
  /// re-geocoding on every update — only the address fields changing
  /// invalidates this.
  geocodedAt        DateTime?

  /// Token used to access the client self-service portal.
  /// A random UUID — separate from `id` — so portal URLs cannot be guessed
  /// by iterating over sequential IDs.  No auth session required; the token
  /// itself acts as the access credential.
  portalAccessToken String @unique @default(uuid())

  totalSpend      Decimal   @default(0) @db.Decimal(10, 2)
  totalBookings   Int       @default(0)
  lastBookingDate DateTime?

  adminId String
  admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  bookings           Booking[]
  notes              ClientNote[]
  estimates          Estimate[]
  jobs               Job[]
  quotes             Quote[]
  recurringSchedules RecurringSchedule[]
  legacyInvoices      Invoice[] @relation("LegacyInvoiceClient") @ignore
  // Added to satisfy BookingChangeRequest.client's back-relation —
  // rename to match whatever `BookingChangeRequest` calls this
  // relation on your side if it differs.
  bookingChangeRequests BookingChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, adminId])
  @@index([adminId])
  @@index([status])
  // NOTE: `name` and `email` also have GIN trigram indexes (pg_trgm) applied
  // via a raw-SQL migration — see
  // prisma/migrations/20260806120000_client_search_trgm_indexes/migration.sql.
  // They aren't declared here because this schema doesn't enable Prisma's
  // `postgresqlExtensions` preview feature; the indexes still exist in the
  // database and Postgres uses them automatically for the `contains`
  // (ILIKE) searches issued by QueryBuilder.search() against
  // clientSearchableFields. Don't remove them via `prisma db push` without
  // re-adding the migration's CREATE INDEX statements.
  @@map("client")
}

model ClientNote {
  id   String @id @default(uuid())
  text String

  /// Historical creator label from the pre-tenant-note model.
  legacyCreatedBy String @default("") @map("createdBy") @ignore

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("client_note")
}
