model BookingForm {
  id                  String                  @id @default(uuid())
  slug                String                  @unique
  published           Boolean                 @default(false)
  headline            String
  subheading          String?
  accentColor         String                  @default("#000000")
  showReviews         Boolean                 @default(true)
  ctaLabel            String?                 @default("Request booking")
  confirmationMessage String?
  availableDays       String[]
  blockedDates        String[]
  timeSlots           String[]
  maxBookingsPerSlot  Int                     @default(1)
  slotDurationMinutes Int                     @default(120)
  bufferTimeMinutes   Int                     @default(0)
  adminId             String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  admin               AdminProfile            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  fields              BookingFormField[]
  services            BookingFormService[]
  submissions         BookingFormSubmission[]
  primaryForWebsites  BusinessWebsite[]         @relation("WebsitePrimaryBookingForm")

  @@index([adminId])
  @@map("booking_form")
}

model BookingFormField {
  id          String        @id @default(uuid())
  type        FormFieldType
  label       String
  placeholder String?
  required    Boolean       @default(false)
  enabled     Boolean       @default(true)
  options     String[]
  sortOrder   Int           @default(0)
  formId      String
  form        BookingForm   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("booking_form_field")
}

model BookingFormService {
  id               String          @id @default(uuid())
  // Legacy compatibility only. Canonical identity is serviceCatalogId.
  serviceType      ServiceType?
  serviceCatalogId String?
  enabled          Boolean         @default(true)
  priceLabel       String?
  duration         String?
  formId           String
  form             BookingForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)

  // Canonical catalog identity is unique per form. Legacy-only uniqueness is
  // enforced by a partial unique index in the Phase 5 migration so distinct
  // catalog services may share the same compatibility ServiceType.
  @@unique([formId, serviceCatalogId])
  @@index([formId, serviceType])
  @@index([serviceCatalogId])
  @@map("booking_form_service")
}

model BookingFormSubmission {
  id                  String               @id @default(uuid())
  ref                 String               @unique
  status              FormSubmissionStatus @default(NEW)
  // serviceType is retained for old records/clients; catalog ID is canonical.
  serviceType         ServiceType?
  serviceCatalogId    String?
  serviceNameSnapshot String?
  priceSnapshot       Decimal?             @db.Decimal(10, 2)
  durationSnapshot    String?
  idempotencyKey      String?
  convertedBookingId  String?              @unique
  convertedAt         DateTime?
  // Stable source attribution for submissions created through a BusinessWebsite.
  // Legacy/direct public form links leave this null.
  sourceWebsiteId     String?
  date                DateTime
  timeSlot    String
  name        String
  email       String
  phone       String
  address     String
  notes       String?
  answers     Json?
  formId      String
  createdAt   DateTime             @default(now())
  form        BookingForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  convertedBooking Booking?         @relation("BookingFormSubmissionConversion", fields: [convertedBookingId], references: [id], onDelete: SetNull)
  sourceWebsite BusinessWebsite?    @relation("WebsiteAcquisitionBookingSubmission", fields: [sourceWebsiteId], references: [id], onDelete: SetNull)

  @@index([formId, status])
  @@index([serviceCatalogId])
  @@index([sourceWebsiteId, createdAt])
  @@unique([formId, idempotencyKey])
  @@map("booking_form_submission")
}

model EstimateForm {
  id                  String                   @id @default(uuid())
  slug                String                   @unique
  published           Boolean                  @default(false)
  headline            String
  subheading          String?
  accentColor         String                   @default("#000000")
  showReviews         Boolean                  @default(true)
  ctaLabel            String?                  @default("Get my free estimate")
  confirmationMessage String?
  coveredPostcodes    String[]
  coveredCities       String[]
  showLiveEstimate    Boolean                  @default(true)
  adminId             String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  admin               AdminProfile             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  addOns              EstimateFormAddOn[]
  fields              EstimateFormField[]
  services            EstimateFormService[]
  submissions         EstimateFormSubmission[]
  primaryForWebsites  BusinessWebsite[]          @relation("WebsitePrimaryEstimateForm")

  @@index([adminId])
  @@map("estimate_form")
}

model EstimateFormField {
  id          String        @id @default(uuid())
  type        FormFieldType
  label       String
  placeholder String?
  required    Boolean       @default(false)
  enabled     Boolean       @default(true)
  options     String[]
  sortOrder   Int           @default(0)
  formId      String
  form        EstimateForm  @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("estimate_form_field")
}

model EstimateFormService {
  id               String          @id @default(uuid())
  serviceType      ServiceType?
  serviceCatalogId String?
  enabled          Boolean         @default(true)
  basePrice        Decimal?        @db.Decimal(10, 2)
  formId           String
  form             EstimateForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)

  // Canonical catalog identity is unique per form. Legacy-only uniqueness is
  // enforced by a partial unique index in the Phase 5 migration so distinct
  // catalog services may share the same compatibility ServiceType.
  @@unique([formId, serviceCatalogId])
  @@index([formId, serviceType])
  @@index([serviceCatalogId])
  @@map("estimate_form_service")
}

model EstimateFormAddOn {
  id      String       @id @default(uuid())
  label   String
  price   Decimal      @db.Decimal(10, 2)
  enabled Boolean      @default(true)
  formId  String
  form    EstimateForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("estimate_form_add_on")
}

model EstimateFormSubmission {
  id                  String                   @id @default(uuid())
  ref                 String                   @unique
  status              EstimateSubmissionStatus @default(NEW)
  serviceType         ServiceType?
  serviceCatalogId    String?
  serviceNameSnapshot String?
  priceSnapshot       Decimal?                 @db.Decimal(10, 2)
  durationSnapshot    String?
  idempotencyKey      String?
  // Stable source attribution for submissions created through a BusinessWebsite.
  sourceWebsiteId     String?
  bedrooms            Int
  bathrooms   Int
  addOnIds    String[]
  postcode        String
  city            String?
  name            String
  email           String
  phone           String
  notes           String?
  answers         Json?
  estimatedMin    Decimal?                 @db.Decimal(10, 2)
  estimatedMax    Decimal?                 @db.Decimal(10, 2)
  pricingSnapshot Json?
  formId          String
  createdAt   DateTime                 @default(now())
  form        EstimateForm             @relation(fields: [formId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog?       @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  sourceWebsite BusinessWebsite?        @relation("WebsiteAcquisitionEstimateSubmission", fields: [sourceWebsiteId], references: [id], onDelete: SetNull)

  @@index([formId, status])
  @@index([serviceCatalogId])
  @@index([sourceWebsiteId, createdAt])
  @@unique([formId, idempotencyKey])
  @@map("estimate_form_submission")
}
