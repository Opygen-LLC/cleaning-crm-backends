model Job {
    id        String    @id @default(uuid())
    jobRef    String    @unique //? e.g. "#JOB-0041" — generated by backend
    status    JobStatus @default(SCHEDULED)

    //? Service details
    serviceType   ServiceType
    address       String
    scheduledDate DateTime
    durationMins  Int     //? stored as minutes
    notes         String?

    //? Optional source references
    quoteId    String?
    quote      Quote?   @relation(fields: [quoteId], references: [id])

    estimateId String?
    estimate   Estimate? @relation(fields: [estimateId], references: [id])

    //? Converted from booking (1-to-1)
    bookingId String?  @unique
    booking   Booking? @relation(fields: [bookingId], references: [id])

    //? Relations
    adminId String
    admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

    clientId String
    client   Client @relation(fields: [clientId], references: [id])

    //? Staff assignments (many-to-many)
    staffAssignments JobStaffAssignment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([adminId, status])
    @@index([clientId])
    @@index([scheduledDate])
    @@map("job")
}

//? Many-to-many: Job ↔ StaffProfile
model JobStaffAssignment {
    jobId String
    job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

    staffId String
    staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

    assignedAt DateTime @default(now())

    @@id([jobId, staffId])
    @@map("job_staff_assignment")
}
