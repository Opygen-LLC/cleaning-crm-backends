model Job {
  id               String               @id @default(uuid())
  jobRef           String               @unique
  status           JobStatus            @default(SCHEDULED)
  serviceType      ServiceType
  address          String
  /// [Phase 2 — location-aware dispatch] Geocoded from `address` on
  /// create/update. Nullable — see Client.latitude for the same contract.
  latitude         Float?
  longitude        Float?
  geocodedAt       DateTime?
  scheduledDate    DateTime
  durationMins     Int
  notes            String?
  quoteId          String?
  estimateId       String?
  bookingId        String?              @unique
  adminId          String
  clientId         String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  admin            AdminProfile         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  booking          Booking?             @relation(fields: [bookingId], references: [id])
  client           Client               @relation(fields: [clientId], references: [id])
  estimate         Estimate?            @relation(fields: [estimateId], references: [id])
  quote            Quote?               @relation(fields: [quoteId], references: [id])
  staffAssignments JobStaffAssignment[]
  reviewToken      ReviewToken?
  checklists       JobChecklist[]
  // ── [NEW] Phase 1 ──────────────────────────────────────────────────────────
  jobNotes         JobNote[]
  jobAttachments   JobAttachment[]

  @@index([adminId, status])
  @@index([clientId])
  @@index([scheduledDate])
  // PERF FIX (Phase 3.3): generateJobRef() looks up this admin's most
  // recent job via `where: { adminId }, orderBy: { createdAt: "desc" }`
  // on every job creation. Without this, that query (and the STAFF/admin
  // job-history-by-recency access patterns generally) forces a sort over
  // every row for the admin instead of an index-backed lookup.
  @@index([adminId, createdAt])
  @@map("job")
}

model JobStaffAssignment {
  jobId       String
  staffId     String
  assignedAt  DateTime     @default(now())
  // ── [NEW] Phase 2 — check-in / check-out ─────────────────────────────────
  checkInAt   DateTime?
  checkOutAt  DateTime?
  hoursWorked Decimal?     @db.Decimal(6, 2)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([jobId, staffId])
  // PERF FIX (Phase 3.2): the composite primary key (jobId, staffId) is
  // jobId-first, so it only helps lookups that *start* with jobId. Every
  // "jobs for this staff member" query (getAllJobs' STAFF branch above,
  // plus dashboard.service.ts's getStaffDashboard) filters by staffId
  // alone, which couldn't use that PK and forced a full scan of this
  // table. This index makes those lookups index-backed.
  @@index([staffId])
  @@map("job_staff_assignment")
}
