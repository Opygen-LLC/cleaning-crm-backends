model Job {
  id               String               @id @default(uuid())
  jobRef           String               @unique
  status           JobStatus            @default(SCHEDULED)
  serviceType      ServiceType
  address          String
  scheduledDate    DateTime
  durationMins     Int
  notes            String?
  quoteId          String?
  estimateId       String?
  bookingId        String?              @unique
  adminId          String
  clientId         String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  admin            AdminProfile         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  booking          Booking?             @relation(fields: [bookingId], references: [id])
  client           Client               @relation(fields: [clientId], references: [id])
  estimate         Estimate?            @relation(fields: [estimateId], references: [id])
  quote            Quote?               @relation(fields: [quoteId], references: [id])
  staffAssignments JobStaffAssignment[]
  reviewToken      ReviewToken?
  checklists       JobChecklist[]
  // ── [NEW] Phase 1 ──────────────────────────────────────────────────────────
  jobNotes         JobNote[]
  jobAttachments   JobAttachment[]

  @@index([adminId, status])
  @@index([clientId])
  @@index([scheduledDate])
  @@map("job")
}

model JobStaffAssignment {
  jobId       String
  staffId     String
  assignedAt  DateTime     @default(now())
  // ── [NEW] Phase 2 — check-in / check-out ─────────────────────────────────
  checkInAt   DateTime?
  checkOutAt  DateTime?
  hoursWorked Decimal?     @db.Decimal(6, 2)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([jobId, staffId])
  @@map("job_staff_assignment")
}
