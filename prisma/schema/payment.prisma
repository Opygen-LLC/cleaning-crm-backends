model Payment {
  id                String        @id @default(uuid())
  paymentRef        String        @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          Currency      @default(USD)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  note              String?
  transactionId     String?
  invoiceUrl        String?
  refundAmount      Decimal?      @db.Decimal(10, 2)
  gatewayPaymentId  String?
  gatewayCustomerId String?
  adminId           String
  invoiceId         String?
  paidAt            DateTime?
  // ── Manual proof-of-payment approval ─────────────────────────────────
  paymentProofUrl   String?       // client submits bank-transfer screenshot
  approvedAt        DateTime?
  approvedByUserId  String?
  rejectionReason   String?
  // ─────────────────────────────────────────────────────────────────────
  createdAt         DateTime      @default(now())
  updatedAt         DateTime?     @updatedAt
  admin             AdminProfile  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([adminId])
  @@index([adminId, status, paidAt(sort: Desc), createdAt(sort: Desc)])
  @@index([invoiceId])
  @@map("payment")
}
