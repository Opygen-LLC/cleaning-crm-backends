model Invoice {
  id         String        @id @default(uuid())
  invoiceRef String        @unique
  status     InvoiceStatus @default(DRAFT)

  // Client Details (Standalone - no relation)
  clientName       String
  clientEmail      String
  serviceAddress   String
  linkedBookingRef String?

  // Service Relation
  serviceCatalogId    String?
  serviceNameSnapshot String?
  serviceCatalog      ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)

  lineItems Json? @default("[]") // description, quantity, unitPrice, total

  notes String? @db.Text

  // Dates
  issuedDate DateTime
  dueDate    DateTime
  paidDate   DateTime?
  sentAt     DateTime?

  // Summary
  subtotal  Decimal @db.Decimal(10, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  taxAmount Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  // Relations
  adminId          String
  bookingId        String?           @unique

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  admin            AdminProfile      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  booking          Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payments         Payment[]

  /// Legacy invoice fields/tables are retained but not exposed to application code.
  legacyServiceType   ServiceType? @map("serviceType") @ignore
  legacyAddress       String       @default("") @map("address") @ignore
  legacyTax           Decimal      @default(0) @db.Decimal(10, 2) @map("tax") @ignore
  legacyInternalNotes String?      @map("internalNotes") @ignore
  legacyClientId      String?      @map("clientId") @ignore
  legacyClient        Client?      @relation("LegacyInvoiceClient", fields: [legacyClientId], references: [id], onDelete: Restrict) @ignore
  legacyLineItems     LegacyInvoiceLineItem[] @ignore

  @@index([adminId])
  @@index([adminId, status])
  @@index([dueDate])
  // PERF FIX (Phase 4): getDashboardOverview / getRevenuePage both
  // date_trunc-aggregate PAID invoices by adminId + paidDate range. The
  // existing [adminId, status] index still helps filter to PAID, but the
  // paidDate range/order-by isn't covered — this index lets that filter +
  // range scan happen without touching status-mismatched rows at all.
  @@index([adminId, status, paidDate])
  // PERF FIX #18: Queries that list all invoices for an admin without a
  // status filter (e.g. listing all invoices for an admin) cannot use the
  // composite [adminId, status] index efficiently. A solo adminId index
  // covers those scans.
  @@map("invoice")
}
