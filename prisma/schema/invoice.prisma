//? ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
    id         String        @id @default(uuid())
    invoiceRef String        @unique //? e.g. "#INV-0024" — generated by backend
    status     InvoiceStatus @default(DRAFT)

    //? Service details
    serviceType ServiceType
    address     String

    //? Financials
    subtotal Decimal @db.Decimal(10, 2)
    taxRate  Decimal @db.Decimal(5, 2)  //? percentage e.g. 20.00
    tax      Decimal @db.Decimal(10, 2)
    total    Decimal @db.Decimal(10, 2)

    //? Dates
    issuedDate DateTime
    dueDate    DateTime
    paidDate   DateTime?
    sentAt     DateTime?

    notes         String?
    internalNotes String?

    //? Relations
    adminId String
    admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

    clientId String
    client   Client @relation(fields: [clientId], references: [id])

    // //? Optional: linked booking that generated this invoice
    bookingId String?  @unique
    booking   Booking? @relation(fields: [bookingId], references: [id])

    //? Line items
    lineItems InvoiceLineItem[]

    //? Payments recorded against this invoice
    payments Payment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([adminId, status])
    @@index([clientId])
    @@index([dueDate])
    @@map("invoice")
}

model InvoiceLineItem {
    id          String  @id @default(uuid())
    description String
    quantity    Int
    unitPrice   Decimal @db.Decimal(10, 2)
    total       Decimal @db.Decimal(10, 2) //? quantity × unitPrice

    invoiceId String
    invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    @@index([invoiceId])
    @@map("invoice_line_item")
}
