model ServiceCatalog {
  id           String        @id @default(uuid())
  serviceName  String
  slug         String        @default("")
  description  String
  // Canonical price amount in the owning business's AdminProfile.currency.
  // The database column keeps its legacy name for a zero-downtime rollout.
  basePrice    Float         @default(0.0) @map("basePriceGbp")
  duration     String
  category     ServiceCategory @default(RESIDENTIAL)
  status       ServiceStatus @default(ACTIVE)
  onlineBookingEnabled Boolean @default(true)
  // Phase 0 compatibility: optional mapping to the legacy hard-coded enum.
  // New/custom catalog services may intentionally leave this null.
  legacyServiceType ServiceType?

  adminId String
  admin   AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  addOns Json? @default("[]")

  invoices       Invoice[]
  estimates      Estimate[]
  quotes         Quote[]
  quoteTemplates QuoteTemplate[]

  bookingFormServices     BookingFormService[]
  bookingFormSubmissions  BookingFormSubmission[]
  estimateFormServices    EstimateFormService[]
  estimateFormSubmissions EstimateFormSubmission[]
  bookings                Booking[]
  jobs                    Job[]
  recurringSchedules      RecurringSchedule[]
  checklistTemplates      ChecklistTemplate[]
  leads                    Lead[]
  websiteSubmissions       WebsiteSubmission[]
  reviews                  Review[]

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt


  @@unique([serviceName, adminId])
  @@unique([adminId, slug])
  @@index([adminId, category, status])
  @@index([adminId, archivedAt, status])
  @@index([adminId, legacyServiceType])
  @@map("service_catalog")
}
