{
    email {$ACME_EMAIL:ops@opygen.com}
    servers {
        protocols h1 h2 h3
    }
}

(api_proxy) {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle /socket.io/* {
        reverse_proxy api:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                keepalive 30s
                keepalive_idle_conns 32
            }
        }
    }

    handle {
        reverse_proxy api:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                keepalive 30s
                keepalive_idle_conns 32
            }
        }
    }

    log {
        output stdout
        format json
    }
}

# Current raw-IP upstream used by the Next.js BFF.
http://34.131.56.92 {
    import api_proxy
}

api-3000.faysaldev.com {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    import api_proxy
}

# Preferred production endpoint. Once api.opygen.com points to 34.131.56.92,
# Caddy automatically provisions TLS and the BFF can switch to HTTPS upstream.
{$API_DOMAIN:api.opygen.com} {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    import api_proxy
}
